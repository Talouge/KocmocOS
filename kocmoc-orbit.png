#!/usr/bin/env python3
"""kocmoc-helper: the ONLY privileged entry point of the Kocmoc apps.

Invoked via pkexec (polkit action org.kocmoc.helper, auth_admin_keep).
Every command is whitelisted and every argument validated.
"""
import grp
import os
import pwd
import re
import subprocess
import sys

NAME = re.compile(r"^[a-z0-9@._+-]+$")
USER = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
HOST = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,62}$")
HASH = re.compile(r"^\$(6|5|y|2b)\$[./A-Za-z0-9$]+$")
PROTECTED = {"base", "linux", "linux-firmware", "filesystem", "glibc", "pacman", "systemd", "sudo",
             "polkit", "python", "python-gobject", "gtk4", "labwc", "greetd", "cage", "waybar",
             "networkmanager", "mkinitcpio"}


def die(msg, code=2):
    print(f"kocmoc-helper: {msg}", file=sys.stderr)
    sys.exit(code)


def caller():
    uid = int(os.environ.get("PKEXEC_UID", "-1"))
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return None


def need(args, n):
    if len(args) != n:
        die("wrong number of arguments")


def pkgs(args):
    if not args or not all(NAME.match(a) for a in args):
        die("invalid package name")
    return args


def normal_user(name):
    if not USER.match(name):
        die("invalid user name")
    try:
        pw = pwd.getpwnam(name)
    except KeyError:
        die("no such user")
    if pw.pw_uid < 1000 or pw.pw_uid >= 60000:
        die("refusing to touch system accounts")
    return pw


def read_hash():
    h = sys.stdin.readline().strip()
    if not HASH.match(h):
        die("invalid password hash")
    return h


def sh(*cmd):
    r = subprocess.run(cmd)
    if r.returncode:
        die(f"{cmd[0]} failed ({r.returncode})", r.returncode)


def main():
    if os.geteuid() != 0:
        die("must be run through pkexec")
    if len(sys.argv) < 2:
        die("no command")
    cmd, args = sys.argv[1], sys.argv[2:]
    os.environ["LC_ALL"] = "C"

    if cmd == "pkg-install":
        os.execvp("pacman", ["pacman", "-Syu", "--needed", "--noconfirm", "--", *pkgs(args)])
    elif cmd == "pkg-remove":
        bad = PROTECTED.intersection(pkgs(args))
        if bad:
            die("refusing to remove core package(s): " + ", ".join(sorted(bad)))
        os.execvp("pacman", ["pacman", "-Rns", "--noconfirm", "--", *args])
    elif cmd == "sys-upgrade":
        need(args, 0)
        os.execvp("pacman", ["pacman", "-Syu", "--noconfirm"])
    elif cmd == "pkg-clean":
        need(args, 0)
        os.execvp("paccache", ["paccache", "-rk2"])
    elif cmd == "user-add":
        need(args, 3)
        user, full, admin = args
        if not USER.match(user):
            die("invalid user name")
        if any(c in full for c in ":,\n") or len(full) > 64:
            die("invalid full name")
        try:
            pwd.getpwnam(user)
            die("user already exists")
        except KeyError:
            pass
        h = read_hash()
        extra = ["-G", "wheel"] if admin == "1" else []
        sh("useradd", "-m", "-s", "/bin/bash", "-c", full, *extra, user)
        sh("usermod", "-p", h, user)
    elif cmd == "user-del":
        need(args, 1)
        pw = normal_user(args[0])
        if pw.pw_name == caller():
            die("you cannot delete your own account")
        sh("userdel", "-r", pw.pw_name)
    elif cmd == "user-admin":
        need(args, 2)
        pw = normal_user(args[0])
        if args[1] == "1":
            sh("gpasswd", "-a", pw.pw_name, "wheel")
        else:
            if pw.pw_name == caller():
                die("you cannot remove your own administrator rights")
            sh("gpasswd", "-d", pw.pw_name, "wheel")
    elif cmd == "user-passwd":
        need(args, 1)
        pw = normal_user(args[0])
        sh("usermod", "-p", read_hash(), pw.pw_name)
    elif cmd == "firewall":
        need(args, 1)
        if args[0] == "enable":
            sh("ufw", "--force", "enable")
            sh("systemctl", "enable", "--now", "ufw.service")
        elif args[0] == "disable":
            sh("ufw", "disable")
        elif args[0] == "status":
            os.execvp("ufw", ["ufw", "status", "verbose"])
        else:
            die("unknown firewall action")
    elif cmd == "hostname":
        need(args, 1)
        if not HOST.match(args[0]):
            die("invalid hostname")
        sh("hostnamectl", "set-hostname", args[0])
    else:
        die(f"unknown command {cmd!r}")


if __name__ == "__main__":
    main()
