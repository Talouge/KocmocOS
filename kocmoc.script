/* Kocmoc panel */
* {
  font-family: "Inter", "Symbols Nerd Font", sans-serif;
  font-size: 13px;
  min-height: 0;
  border: none;
  border-radius: 0;
}
window#waybar {
  background: rgba(14, 14, 14, 0.92);
  color: #e6e6e6;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 16px;
}
tooltip { background: #141414; border: 1px solid #2c2c2c; border-radius: 12px; }
tooltip label { color: #e6e6e6; padding: 4px; }
#image.menu { padding: 0 12px 0 14px; }
#workspaces button, #taskbar button {
  color: #8a8a8a; background: transparent; padding: 0 8px; margin: 5px 1px; border-radius: 10px;
  transition: all 160ms ease;
}
#workspaces button.active { color: #0e0e0e; background: #e6e6e6; }
#workspaces button:hover, #taskbar button:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
#taskbar button.active { background: rgba(255, 255, 255, 0.12); }
#taskbar button.minimized { opacity: 0.45; }
#custom-install {
  background: #e6e6e6; color: #0e0e0e; font-weight: 700; padding: 0 14px; margin: 6px 6px; border-radius: 10px;
}
#tray, #network, #bluetooth, #pulseaudio, #battery, #clock, #custom-quick {
  padding: 0 10px; margin: 5px 0; border-radius: 10px; color: #d6d6d6;
}
#network, #bluetooth, #pulseaudio, #custom-quick { font-size: 16px; }
#clock { font-weight: 600; color: #ffffff; padding: 0 12px; }
#custom-quick { margin-right: 6px; }
#network:hover, #bluetooth:hover, #pulseaudio:hover, #battery:hover, #clock:hover, #custom-quick:hover {
  background: rgba(255, 255, 255, 0.08);
}
#network.disconnected, #bluetooth.off, #pulseaudio.muted { color: #6a6a6a; }
#battery.warning { color: #e8d6a8; }
#battery.critical { color: #e89a9a; }
